{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echofarm.local/contracts/demonstration.schema.json",
  "title": "Demonstration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "saveId", "sessionId", "startedAt", "endedAt", "events"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "saveId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "day": { "type": "integer", "minimum": 1 },
    "weather": { "enum": ["sunny", "rainy", "storm", "snow"] },
    "startedAt": { "type": "integer", "minimum": 0 },
    "endedAt": { "type": "integer", "minimum": 0 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "tick", "position", "delta", "success"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["move", "equip_tool", "water_target", "refill_can", "harvest_target", "deposit_items"] },
          "tick": { "type": "integer", "minimum": 0 },
          "position": { "$ref": "world-snapshot.schema.json#/$defs/position" },
          "targetId": { "type": "string" },
          "tool": { "type": "string" },
          "delta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["energyDelta", "waterDelta", "inventoryDelta"],
            "properties": {
              "energyDelta": { "type": "integer" },
              "waterDelta": { "type": "integer" },
              "inventoryDelta": { "type": "integer" }
            }
          },
          "success": { "type": "boolean" },
          "errorCode": { "type": "string" }
        }
      }
    }
  }
}
