{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echofarm.local/contracts/echo-memory.schema.json",
  "title": "EchoMemoryView",
  "type": "object",
  "additionalProperties": false,
  "required": ["saveId", "modelRevision", "learnedThroughDay"],
  "properties": {
    "saveId": { "type": "string", "minLength": 1 },
    "modelRevision": { "type": "integer", "minimum": 1 },
    "learnedThroughDay": { "type": "integer", "minimum": 0 },
    "stableTraits": {
      "type": "array",
      "items": { "$ref": "player-model.schema.json#/properties/traits/items" }
    },
    "recentLearningChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelRevision", "kind", "summary"],
      "properties": {
        "modelRevision": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["added", "strengthened", "weakened", "unchanged"] },
        "key": { "enum": ["task_order", "preferred_chest", "energy_reserve", "route_style"] },
        "value": { "type": "string" },
        "previousConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "activeSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "day", "status"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "day": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "lastDecision": { "type": "object" }
  }
}
