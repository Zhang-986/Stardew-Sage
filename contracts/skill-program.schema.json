{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echofarm.local/contracts/skill-program.schema.json",
  "title": "SkillProgram",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "revision", "goal", "targetSelector", "steps", "successConditions", "evidenceEventIds"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "targetSelector": { "type": "string", "minLength": 1 },
    "preferredOrder": { "type": "array", "items": { "enum": ["watering", "refilling", "harvesting", "depositing"] } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": { "$ref": "high-level-action.schema.json#/$defs/actionKind" },
          "targetSelector": { "type": "string" }
        }
      }
    },
    "successConditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "stopConditions": { "type": "array", "items": { "type": "string" } },
    "recoveryStrategies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failureCode", "actions"],
        "properties": {
          "failureCode": { "type": "string", "minLength": 1 },
          "actions": { "type": "array", "items": { "$ref": "high-level-action.schema.json#/$defs/actionKind" } }
        }
      }
    },
    "evidenceEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
